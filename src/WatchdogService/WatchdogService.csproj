<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WatchdogService</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.15" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlockPC.Shared\BlockPC.Shared.csproj" />
  </ItemGroup>

</Project>
