{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "BlockPC.BlockerService",
      "LogName": "Application",
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "BlockingPolicy": {
    "PollingIntervalMs": 500,
    "WatchdogIntervalMs": 1000,
    "HostsFileIntervalMs": 5000,
    "EnableAclProtection": true,

    "BlockedProcesses": [
      "taskmgr",
      "cmd",
      "powershell",
      "pwsh",
      "mmc",
      "devenv",
      "regedit",
      "msconfig",
      "perfmon",
      "resmon",
      "procexp",
      "procexp64",
      "procmon",
      "procmon64",
      "autoruns",
      "autoruns64"
    ],

    "BlockedDomains": [
      "youtube.com",
      "facebook.com",
      "instagram.com",
      "twitter.com",
      "x.com",
      "tiktok.com",
      "reddit.com",
      "twitch.tv",
      "netflix.com",
      "primevideo.com",
      "disneyplus.com"
    ]
  }
}
