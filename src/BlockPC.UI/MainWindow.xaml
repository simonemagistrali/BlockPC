<Window x:Class="BlockPC.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockPC - Gestione Blocco" Height="500" Width="600"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Banner -->
        <Border Name="StatusBanner" Background="LightGray" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <TextBlock Name="StatusText" Text="Connessione al servizio in corso..." FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Quick Block -->
                <GroupBox Header="Blocco Rapido (Quick Block)" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Aggiungi ore:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Name="QuickBlockHours" Width="50" Margin="0,0,10,0">
                            <ComboBoxItem Content="1" IsSelected="True"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                        <Button Content="Attiva Ora!" Width="100" Click="BtnQuickBlock_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Liste Processi/Domini -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <GroupBox Header="Processi Bloccati" Grid.Column="0" Margin="0,0,5,0">
                        <StackPanel Margin="5">
                            <ListBox Name="ListProcesses" Height="100" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtNewProcess" Grid.Column="0" Margin="0,0,5,0"/>
                                <Button Content="+" Grid.Column="1" Width="30" Click="BtnAddProcess_Click"/>
                                <Button Name="BtnRemoveProcess" Content="-" Grid.Column="2" Width="30" Margin="5,0,0,0" Click="BtnRemoveProcess_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Domini Bloccati" Grid.Column="1" Margin="5,0,0,0">
                        <StackPanel Margin="5">
                            <ListBox Name="ListDomains" Height="100" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtNewDomain" Grid.Column="0" Margin="0,0,5,0"/>
                                <Button Content="+" Grid.Column="1" Width="30" Click="BtnAddDomain_Click"/>
                                <Button Name="BtnRemoveDomain" Content="-" Grid.Column="2" Width="30" Margin="5,0,0,0" Click="BtnRemoveDomain_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- Scheduling -->
                <GroupBox Header="Fasce Orarie (Schedule)" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Giorni Attivi:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <WrapPanel Name="PanelDays" Margin="0,0,0,10">
                            <!-- Populated in code-behind -->
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dalle:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Name="TxtStartTime" Width="50" Text="09:00" Margin="0,0,15,0"/>
                            
                            <TextBlock Text="Alle:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Name="TxtEndTime" Width="50" Text="18:00"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Save -->
        <Button Grid.Row="2" Content="Salva e Applica Policy" Height="35" FontWeight="Bold" Click="BtnSave_Click"/>
    </Grid>
</Window>
